{
  "name": "armagedon-rpg-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:js": "node tools/check-js.cjs",
    "audit:static": "node tools/audit-static.cjs",
    "audit:pendencias": "node tools/audit-pendencias.cjs",
    "build:pages": "node tools/build-pages.cjs",
    "test:mesa": "playwright test tests/mesa.spec.cjs",
    "test:mesa:audit": "playwright test tests/mesa-audit.spec.cjs",
    "test:mesa:scenemap": "playwright test tests/mesa-scene-map.spec.cjs",
    "test:mesa:scenes": "playwright test tests/mesa-scenes.spec.cjs",
    "test:mesa:permissoes": "playwright test tests/mesa-permissions.spec.cjs",
    "test:mesa:tokens": "playwright test tests/mesa-token-handles.spec.cjs",
    "test:mesa:online": "playwright test tests/mesa-online.spec.cjs",
    "test:online": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/run-online-tests.ps1",
    "test:online:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/set-online-credentials.ps1",
    "test:mesa:worker": "playwright test tests/mesa-resize-worker.spec.cjs",
    "test:build": "playwright test tests/build-pages.spec.cjs",
    "test:ficha": "playwright test tests/ficha.spec.cjs",
    "perf:mesa": "playwright test tests/mesa.performance.spec.cjs",
    "test:controles": "playwright test tests/controles-armados.spec.cjs",
    "optimize:images": "node tools/optimize-images.cjs",
    "minify:css": "node tools/minify.cjs --css",
    "minify:js": "node tools/minify.cjs --js",
    "build": "node tools/build-pages.cjs && node tools/minify.cjs",
    "test:mesa:worker:local": "node tools/run-local-worker-tests.cjs",
    "audit:css": "node tools/audit-css.cjs",
    "test:ui:audit": "playwright test tests/project-ui-audit.spec.cjs",
    "test:production": "playwright test tests/production- --workers=1",
    "test:mesa:rules": "node --test tests/mesa-movement-rules.test.cjs tests/mesa-template-rules.test.cjs tests/css-syntax.test.cjs",
    "test:mesa:movement": "playwright test tests/mesa-movement.spec.cjs",
    "test:mesa:persist": "playwright test tests/mesa-persist-compat.spec.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "clean-css": "^5.3.3",
    "sharp": "^0.35.5",
    "terser": "^5.47.1",
    "wrangler": "^4.154.0"
  }
}
