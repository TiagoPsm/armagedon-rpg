#!/usr/bin/env sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if command -v pwsh >/dev/null 2>&1; then
  shell_bin="pwsh"
elif command -v powershell.exe >/dev/null 2>&1; then
  shell_bin="powershell.exe"
elif command -v powershell >/dev/null 2>&1; then
  shell_bin="powershell"
else
  echo "PowerShell nao encontrado. Nao foi possivel atualizar o snapshot do Obsidian." >&2
  exit 1
fi

"$shell_bin" -NoProfile -ExecutionPolicy Bypass -File "$repo_root/tools/update-obsidian-context.ps1"
# Sem `git add`: o snapshot esta no .gitignore desde 2026-08-21. Ele so fica
# pronto DEPOIS de gerado, ja carimbado com o commit anterior, e o hook nao tem
# como carimbar o commit que ainda nao existe — por isso ele nunca fechava e o
# repositorio ficava sujo apos cada commit. Continua sendo gerado aqui, para o
# Obsidian; so nao e versionado. `git add` de arquivo ignorado falha, e com
# `set -eu` isso abortaria o commit inteiro.
