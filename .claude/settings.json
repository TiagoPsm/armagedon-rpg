{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(node --check *)",
      "Bash(node tools/*)",
      "Bash(npx.cmd --yes wrangler* --dry-run*)",
      "Bash(python -m http.server*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git fsck*)",
      "Bash(git check*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if (Test-Path 'tools\\update-obsidian-context.ps1') { .\\tools\\update-obsidian-context.ps1 }",
            "shell": "powershell",
            "timeout": 30,
            "statusMessage": "Atualizando contexto Obsidian..."
          }
        ]
      }
    ]
  }
}
